#!/bin/sh

# Apply ATS test parameter overrides from environment variables.
# These are set by the test fixture before starting PX4.
[ -n "$PARAM_AV_ATS_EN" ]        && param set AV_ATS_EN         $PARAM_AV_ATS_EN
[ -n "$PARAM_AV_ATS_TIMEOUT" ]   && param set AV_ATS_TIMEOUT   $PARAM_AV_ATS_TIMEOUT
[ -n "$PARAM_AV_ATS_ACC_NORM" ]  && param set AV_ATS_ACC_NORM  $PARAM_AV_ATS_ACC_NORM
[ -n "$PARAM_AV_ATS_ROLL_ANG" ]  && param set AV_ATS_ROLL_ANG  $PARAM_AV_ATS_ROLL_ANG
[ -n "$PARAM_AV_ATS_PITCH_ANG" ] && param set AV_ATS_PITCH_ANG $PARAM_AV_ATS_PITCH_ANG

[ -n "$PARAM_AV_ATS_V_EN" ]      && param set AV_ATS_V_EN     $PARAM_AV_ATS_V_EN
[ -n "$PARAM_AV_ATS_MP_LOWV" ]   && param set AV_ATS_MP_LOWV  $PARAM_AV_ATS_MP_LOWV
[ -n "$PARAM_AV_ATS_PARA_LOWV" ] && param set AV_ATS_PARA_LOWV $PARAM_AV_ATS_PARA_LOWV
[ -n "$PARAM_AV_ATS_UPS_LOWV" ]  && param set AV_ATS_UPS_LOWV $PARAM_AV_ATS_UPS_LOWV

# ADC channel/divider config (shared by ATS and the ADC mock)
[ -n "$PARAM_AV_ATS_MP1_CH" ]  && param set AV_ATS_MP1_CH  $PARAM_AV_ATS_MP1_CH
[ -n "$PARAM_AV_ATS_MP1_DV" ]  && param set AV_ATS_MP1_DV  $PARAM_AV_ATS_MP1_DV
[ -n "$PARAM_AV_ATS_MP2_CH" ]  && param set AV_ATS_MP2_CH  $PARAM_AV_ATS_MP2_CH
[ -n "$PARAM_AV_ATS_MP2_DV" ]  && param set AV_ATS_MP2_DV  $PARAM_AV_ATS_MP2_DV
[ -n "$PARAM_AV_ATS_UPS_CH" ]  && param set AV_ATS_UPS_CH  $PARAM_AV_ATS_UPS_CH
[ -n "$PARAM_AV_ATS_UPS_DV" ]  && param set AV_ATS_UPS_DV  $PARAM_AV_ATS_UPS_DV
[ -n "$PARAM_AV_ATS_PARA_CH" ]  && param set AV_ATS_PARA_CH  $PARAM_AV_ATS_PARA_CH
[ -n "$PARAM_AV_ATS_PARA_DV" ]  && param set AV_ATS_PARA_DV  $PARAM_AV_ATS_PARA_DV

# Simulated voltages (ADC mock only)
[ -n "$PARAM_AV_ATS_MP1_SM" ] && param set AV_ATS_MP1_SM $PARAM_AV_ATS_MP1_SM
[ -n "$PARAM_AV_ATS_MP2_SM" ] && param set AV_ATS_MP2_SM $PARAM_AV_ATS_MP2_SM
[ -n "$PARAM_AV_ATS_UPS_SM" ] && param set AV_ATS_UPS_SM $PARAM_AV_ATS_UPS_SM
[ -n "$PARAM_AV_ATS_PARA_SM" ] && param set AV_ATS_PARA_SM $PARAM_AV_ATS_PARA_SM

aviant_ats start
ats_adc_mock start

# Second MAVLink link for the parachute mock (component 161).

# shellcheck disable=SC2154
udp_parachute_port_local=$((udp_offboard_port_local + 1))
# shellcheck disable=SC2154
udp_parachute_port_remote=$((udp_offboard_port_remote + 1))
mavlink start -x -u $udp_parachute_port_local -r 4000000 -f -m onboard -o $udp_parachute_port_remote

# Stream ATS status on the offboard/API link so the test harness can read it.
mavlink stream -r 5 -s AVIANT_ATS_STATUS -u ${udp_offboard_port_local:?}
