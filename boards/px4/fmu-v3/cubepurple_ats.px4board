CONFIG_MODULES_FLIGHT_MODE_MANAGER=n
CONFIG_MODULES_FW_ATT_CONTROL=n
CONFIG_MODULES_FW_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_FW_POS_CONTROL=n
CONFIG_MODULES_FW_RATE_CONTROL=n
CONFIG_MODULES_GIMBAL=n
CONFIG_MODULES_LAND_DETECTOR=n
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=n
CONFIG_MODULES_LOCAL_POSITION_ESTIMATOR=n
CONFIG_MODULES_MANUAL_CONTROL=n
CONFIG_MODULES_MC_ATT_CONTROL=n
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=n
CONFIG_MODULES_MC_POS_CONTROL=n
CONFIG_MODULES_MC_RATE_CONTROL=n
CONFIG_MODULES_NAVIGATOR=n
CONFIG_MODULES_ROVER_POS_CONTROL=n
CONFIG_MODULES_UUV_ATT_CONTROL=n
CONFIG_MODULES_UUV_POS_CONTROL=n
CONFIG_MODULES_VTOL_ATT_CONTROL=n
# Disable IMU drivers not on CubePurple
CONFIG_DRIVERS_IMU_ANALOG_DEVICES_ADIS16448=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20608G=n
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20948=n
CONFIG_DRIVERS_IMU_INVENSENSE_MPU6000=n
CONFIG_DRIVERS_IMU_ST_L3GD20=n
CONFIG_DRIVERS_IMU_ST_LSM303D=n
# Disable unused drivers and sensors
CONFIG_DRIVERS_CAMERA_CAPTURE=n
CONFIG_DRIVERS_CAMERA_TRIGGER=n
CONFIG_DRIVERS_GPS=n
CONFIG_DRIVERS_GNSS_SEPTENTRIO=n
CONFIG_DRIVERS_IRLOCK=n
CONFIG_SENSORS_VEHICLE_GNSS_HEADING=n
CONFIG_EXAMPLES_FAKE_GPS=n
CONFIG_DRIVERS_SMART_BATTERY_BATMON=n
CONFIG_DRIVERS_BATT_SMBUS=n
CONFIG_DRIVERS_UAVCAN=n
# Disable unused sensor categories
CONFIG_COMMON_DIFFERENTIAL_PRESSURE=n
CONFIG_COMMON_OPTICAL_FLOW=n
CONFIG_COMMON_DISTANCE_SENSOR=n
CONFIG_COMMON_LIGHT=n
# Enable ATS modules
CONFIG_MODULES_AVIANT_ATS=y
# Enable dmesg
CONFIG_SYSTEMCMDS_DMESG=y
